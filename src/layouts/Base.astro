---
// 역할: 모든 화면의 공통 틀(색·글꼴·머리줄 S06). 호출: src/pages/*.astro.
import Header from '../components/Header.astro';
interface Props { title?: string; description?: string }
const { title, description = '돌아갈 때까지 만듭니다 — 캠핑하는 개발자 HENRY' } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · nowcompiling` : 'nowcompiling'}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Header />
    <main><slot /></main>
  </body>
</html>
<style is:global>
  :root { --bg: #07080d; --bg2: #0d1226; --line: #1f2240; --text: #dfe6f5; --muted: #8b93ad; --accent: #ffb36b; --link: #bcd0ff; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 17px/1.75 system-ui, -apple-system, "Apple SD Gothic Neo", sans-serif; word-break: keep-all; }
  main { max-width: 680px; margin: 0 auto; padding: 24px 20px 80px; }
  a { color: var(--link); }
  h1, h2, h3 { line-height: 1.35; }
  h2 { font-size: 1.15rem; margin-top: 2.2em; }
  .muted { color: var(--muted); }
  .kind { font-size: .8rem; color: var(--accent); letter-spacing: .04em; }
  ul.posts { list-style: none; padding: 0; margin: 0; }
  ul.posts li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  ul.posts a { text-decoration: none; color: var(--text); font-weight: 600; }
  img { max-width: 100%; border-radius: 8px; }
</style>
